<a:Stereotype>CRUD-Register</a:Stereotype>
<a:ReturnType>bool</a:ReturnType>
<a:TemplateBody>{
    clsProject varObj = opGetProject(prmOUID);
    if(varObj != null) return false;
    return opAssociateProject( new clsProject(prmOUID, prmName, prmDescription, prmStartingDate, prmEndingDate , prmGeneralState, prmAdvancePercentage));
}</a:TemplateBody>
